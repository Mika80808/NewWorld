# 玩家 API Key（Gemini）由使用者在「系統設定」介面輸入，存於 localStorage，無需環境變數。

# ─── Supabase（Google 登入 + 雲端存檔，必填）──────────────────────────────
# 來源：Supabase Dashboard → 你的專案 → Settings → API
# 沒設定的話，首頁的「使用 Google 登入」按鈕會無法運作。
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# APP_URL: 應用部署網址（用於 OAuth redirect）
APP_URL="MY_APP_URL"
